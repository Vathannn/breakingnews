# ==============================================
# SCRIPT TRACKING USER ACTIVITY WITH TELEGRAM
# Letakkan di ~/.bashrc atau /etc/bash.bashrc
# ==============================================

# ----- KONFIGURASI TELEGRAM -----
TELEGRAM_BOT_TOKEN="8764450785:AAHgufM9iacj5N3i3xBRLhtMmoR4ll7ed5g"  # Ganti dengan token bot Anda
TELEGRAM_CHAT_ID="-1003801563204"      # Ganti dengan chat ID Anda
TELEGRAM_ENABLED=true                 # true untuk aktif, false untuk nonaktif

# ----- KONFIGURASI UMUM -----
LOG_DIR="$HOME/.logs"
LOG_FILE="$LOG_DIR/user_activity.log"
SESSION_LOG="$LOG_DIR/session_$(date +%Y%m%d_%H%M%S).log"
COMMAND_LOG="$LOG_DIR/command_history.log"
SSH_LOG="$LOG_DIR/ssh_login.log"
MAX_LOG_SIZE=10485760  # 10MB
NOTIFY_COMMANDS=true   # Notifikasi setiap perintah via Telegram
NOTIFY_LOGIN=true      # Notifikasi saat login
NOTIFY_SSH=true        # Notifikasi saat SSH login

# ----- INISIALISASI -----
[ ! -d "$LOG_DIR" ] && mkdir -p "$LOG_DIR"

# ----- FUNGSI TELEGRAM -----
send_telegram() {
    local message="$1"
    local parse_mode="${2:-HTML}"  # HTML atau Markdown
    
    if [ "$TELEGRAM_ENABLED" != "true" ]; then
        return 0
    fi
    
    # Escape karakter khusus untuk JSON
    local escaped_message=$(echo "$message" | sed 's/"/\\"/g' | sed 's/&/\&amp;/g' | sed 's/</\&lt;/g' | sed 's/>/\&gt;/g')
    
    curl -s -X POST "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/sendMessage" \
        -H "Content-Type: application/json" \
        -d "{
            \"chat_id\": \"$TELEGRAM_CHAT_ID\",
            \"text\": \"$escaped_message\",
            \"parse_mode\": \"$parse_mode\",
            \"disable_web_page_preview\": true
        }" > /dev/null 2>&1
}

# ----- FUNGSI SEND NOTIFIKASI -----
send_login_notification() {
    local user=$(whoami)
    local host=$(hostname)
    local ip=$(who am i | awk '{print $NF}' | tr -d '()')
    local tty=$(tty)
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    local message="<b>🔐 USER LOGIN DETECTED</b>
    
<b>User:</b> <code>$user</code>
<b>Host:</b> <code>$host</code>
<b>IP Address:</b> <code>$ip</code>
<b>TTY:</b> <code>$tty</code>
<b>Time:</b> <code>$timestamp</code>
<b>Type:</b> $( [ -n "$SSH_CONNECTION" ] && echo "SSH" || echo "Local" )"

    send_telegram "$message" "HTML"
}

send_command_notification() {
    local cmd="$1"
    local exit_code="$2"
    local user=$(whoami)
    local host=$(hostname)
    local pwd=$(pwd)
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    # Jangan kirim notifikasi untuk perintah tertentu (opsional)
    local ignore_commands=("clear" "history" "ls" "ll" "pwd")
    for ignore in "${ignore_commands[@]}"; do
        if [[ "$cmd" == "$ignore"* ]]; then
            return 0
        fi
    done
    
    local status_emoji="✅"
    local status_text="SUCCESS"
    if [ "$exit_code" -ne 0 ]; then
        status_emoji="❌"
        status_text="ERROR (exit: $exit_code)"
    fi
    
    local message="<b>💻 COMMAND EXECUTED</b> $status_emoji

<b>User:</b> <code>$user</code>
<b>Host:</b> <code>$host</code>
<b>Directory:</b> <code>$pwd</code>
<b>Command:</b> <code>$cmd</code>
<b>Status:</b> $status_text
<b>Time:</b> <code>$timestamp</code>"

    send_telegram "$message" "HTML"
}

send_ssh_notification() {
    local user=$(whoami)
    local client_ip=$(echo "$SSH_CONNECTION" | awk '{print $1}')
    local client_port=$(echo "$SSH_CONNECTION" | awk '{print $2}')
    local server_ip=$(echo "$SSH_CONNECTION" | awk '{print $3}')
    local server_port=$(echo "$SSH_CONNECTION" | awk '{print $4}')
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    # Cek lokasi dengan IP geolocation (opsional)
    local location="Unknown"
    if command -v curl &> /dev/null; then
        location=$(curl -s "http://ip-api.com/json/$client_ip" | grep -o '"country":"[^"]*"' | cut -d'"' -f4 2>/dev/null || echo "Unknown")
    fi
    
    local message="<b>🌐 SSH LOGIN DETECTED</b>

<b>User:</b> <code>$user</code>
<b>Client IP:</b> <code>$client_ip</code>
<b>Client Port:</b> <code>$client_port</code>
<b>Server IP:</b> <code>$server_ip</code>
<b>Server Port:</b> <code>$server_port</code>
<b>Location:</b> <code>$location</code>
<b>Time:</b> <code>$timestamp</code>

⚠️ <i>SSH Login from remote location!</i>"

    send_telegram "$message" "HTML"
}

send_session_summary() {
    local user=$(whoami)
    local host=$(hostname)
    local duration=$1
    local cmd_count=$2
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    local message="<b>📊 SESSION SUMMARY</b>

<b>User:</b> <code>$user</code>
<b>Host:</b> <code>$host</code>
<b>Duration:</b> <code>$duration</code>
<b>Commands Executed:</b> <code>$cmd_count</code>
<b>Session End:</b> <code>$timestamp</code>"

    send_telegram "$message" "HTML"
}

send_error_notification() {
    local error_msg="$1"
    local user=$(whoami)
    local host=$(hostname)
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    local message="<b>⚠️ ERROR DETECTED</b>

<b>User:</b> <code>$user</code>
<b>Host:</b> <code>$host</code>
<b>Error:</b> <code>$error_msg</code>
<b>Time:</b> <code>$timestamp</code>"

    send_telegram "$message" "HTML"
}

# ----- FUNGSI LOGGING -----
log_activity() {
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local user=$(whoami)
    local host=$(hostname)
    local ip=$(who am i | awk '{print $NF}' | tr -d '()')
    local pwd=$(pwd)
    local last_cmd=$(history 1 | sed 's/^[ ]*[0-9]*[ ]*//')
    
    echo "[$timestamp] USER:$user | HOST:$host | IP:$ip | PWD:$pwd | CMD:$last_cmd" >> "$LOG_FILE"
}

# ----- CEK UKURAN LOG -----
check_log_size() {
    if [ -f "$LOG_FILE" ]; then
        local size=$(stat -c%s "$LOG_FILE" 2>/dev/null || stat -f%z "$LOG_FILE" 2>/dev/null)
        if [ "$size" -gt "$MAX_LOG_SIZE" ] 2>/dev/null; then
            mv "$LOG_FILE" "$LOG_FILE.old"
            touch "$LOG_FILE"
            echo "Log file rotated at $(date)" >> "$LOG_FILE"
            send_telegram "🔄 <b>Log file rotated</b> - Size exceeded 10MB" "HTML"
        fi
    fi
}

# ----- RECORD SESSION -----
record_session_start() {
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local user=$(whoami)
    local host=$(hostname)
    local ip=$(who am i | awk '{print $NF}' | tr -d '()')
    local tty=$(tty)
    
    echo "========================================" >> "$SESSION_LOG"
    echo "SESSION START: $timestamp" >> "$SESSION_LOG"
    echo "USER: $user" >> "$SESSION_LOG"
    echo "HOST: $host" >> "$SESSION_LOG"
    echo "IP: $ip" >> "$SESSION_LOG"
    echo "TTY: $tty" >> "$SESSION_LOG"
    echo "========================================" >> "$SESSION_LOG"
}

record_session_end() {
    if [ -f "$SESSION_LOG" ]; then
        local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
        local start_time=$(head -n 2 "$SESSION_LOG" | grep "SESSION START" | cut -d' ' -f3-4)
        local cmd_count=$(grep -c "CMD:" "$SESSION_LOG" 2>/dev/null || echo 0)
        
        # Hitung durasi session
        if [ -n "$start_time" ]; then
            local start_epoch=$(date -d "$start_time" +%s 2>/dev/null || echo 0)
            local end_epoch=$(date +%s)
            local duration=$((end_epoch - start_epoch))
            local duration_str=""
            
            if [ $duration -gt 0 ]; then
                local hours=$((duration / 3600))
                local minutes=$(((duration % 3600) / 60))
                local seconds=$((duration % 60))
                duration_str=$(printf "%02d:%02d:%02d" $hours $minutes $seconds)
            else
                duration_str="00:00:00"
            fi
            
            echo "========================================" >> "$SESSION_LOG"
            echo "SESSION END: $timestamp" >> "$SESSION_LOG"
            echo "DURATION: $duration_str" >> "$SESSION_LOG"
            echo "COMMANDS: $cmd_count" >> "$SESSION_LOG"
            echo "========================================" >> "$SESSION_LOG"
            
            # Kirim notifikasi session end
            send_session_summary "$duration_str" "$cmd_count"
        fi
    fi
}

# ----- TRACK COMMAND -----
track_command() {
    local exit_code=$?
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local user=$(whoami)
    local cmd=$(history 1 | sed 's/^[ ]*[0-9]*[ ]*//')
    
    # Log ke file
    echo "[$timestamp] $user: $cmd (exit: $exit_code)" >> "$COMMAND_LOG"
    
    # Kirim notifikasi ke Telegram jika enabled
    if [ "$NOTIFY_COMMANDS" = "true" ] && [ -n "$cmd" ]; then
        send_command_notification "$cmd" "$exit_code"
    fi
    
    # Kirim notifikasi error jika ada
    if [ "$exit_code" -ne 0 ] && [ "$exit_code" -ne 130 ] && [ -n "$cmd" ]; then
        # 130 adalah exit code untuk Ctrl+C
        send_error_notification "Command: $cmd (exit code: $exit_code)"
    fi
}

# ----- SETUP PROMPT COMMAND -----
setup_prompt_command() {
    local last_exit=$?
    local cmd=$(history 1 | sed 's/^[ ]*[0-9]*[ ]*//')
    
    if [ -n "$cmd" ]; then
        log_activity
    fi
    
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] CMD: $cmd (exit: $last_exit)" >> "$SESSION_LOG"
}

# ----- TEST KONEKSI TELEGRAM -----
test_telegram_connection() {
    if [ "$TELEGRAM_ENABLED" = "true" ]; then
        local test_message="<b>✅ Bot Connected!</b>

System: $(hostname)
User: $(whoami)
Time: $(date '+%Y-%m-%d %H:%M:%S')
IP: $(hostname -I | awk '{print $1}')

<i>User tracking system is now active.</i>"
        
        send_telegram "$test_message" "HTML"
        
        if [ $? -eq 0 ]; then
            echo "✅ Telegram notification active"
        else
            echo "⚠️ Telegram notification failed - check your token and chat ID"
        fi
    fi
}

# ----- MAIN EXECUTION -----

# Cek konfigurasi Telegram
if [ "$TELEGRAM_ENABLED" = "true" ]; then
    if [ "$TELEGRAM_BOT_TOKEN" = "YOUR_BOT_TOKEN" ] || [ "$TELEGRAM_CHAT_ID" = "YOUR_CHAT_ID" ]; then
        echo "⚠️ WARNING: Telegram not configured. Edit TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID"
        TELEGRAM_ENABLED=false
    fi
fi

# Cek ukuran log
check_log_size

# Kirim notifikasi login
if [ "$NOTIFY_LOGIN" = "true" ]; then
    send_login_notification
fi

# Track SSH login
if [ -n "$SSH_CONNECTION" ] && [ "$NOTIFY_SSH" = "true" ]; then
    send_ssh_notification
    echo "$(date '+%Y-%m-%d %H:%M:%S') SSH Login: $USER from $SSH_CONNECTION" >> "$SSH_LOG"
fi

# Record session start
record_session_start

# Setup PROMPT_COMMAND
PROMPT_COMMAND="setup_prompt_command"

# Trap untuk exit shell
trap record_session_end EXIT

# Test koneksi Telegram
if [ "$TELEGRAM_ENABLED" = "true" ]; then
    test_telegram_connection
fi

