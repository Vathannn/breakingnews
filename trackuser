# ==============================================
# FUNGSI UTILITY
# ==============================================

# Lihat semua aktivitas
view_logs() {
    echo "=== SEMUA AKTIVITAS ==="
    tail -30 "$ACTIVITY_LOG"
}

# Lihat command history
view_commands() {
    echo "=== COMMAND HISTORY ==="
    grep "CMD:" "$ACTIVITY_LOG" | tail -20
}

# Lihat statistik
view_stats() {
    echo "=== STATISTIK ==="
    echo "Total login: $(grep -c "LOGIN" "$ACTIVITY_LOG")"
    echo "Total logout: $(grep -c "LOGOUT" "$ACTIVITY_LOG")"
    echo "Total commands: $(grep -c "CMD:" "$ACTIVITY_LOG")"
    echo "Session logs: $(ls -1 "$LOG_DIR"/session_*.log 2>/dev/null | wc -l)"
}

# Clear logs
clear_logs() {
    echo -n "Hapus semua log? (y/n): "
    read confirm
    if [ "$confirm" = "y" ]; then
        > "$ACTIVITY_LOG"
        echo "Log dibersihkan"
    fi
}

# Alias
alias logs='view_logs'
alias cmds='view_commands'
alias stats='view_stats'
alias clearlogs='clear_logs'

