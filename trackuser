# Fungsi untuk test Telegram
test_telegram() {
    local test_msg="<b>🧪 Test Notification</b>

User: $(whoami)
Host: $(hostname)
Time: $(date '+%Y-%m-%d %H:%M:%S')

<i>If you see this, Telegram integration is working!</i>"
    
    send_telegram "$test_msg" "HTML"
    if [ $? -eq 0 ]; then
        echo "✅ Test message sent to Telegram"
