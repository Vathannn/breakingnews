# Fungsi toggle Telegram
toggle_telegram() {
    if [ "$TELEGRAM_ENABLED" = "true" ]; then
        TELEGRAM_ENABLED=false
        echo "📵 Telegram notifications disabled"
    else
        TELEGRAM_ENABLED=true
        echo "📱 Telegram notifications enabled"
        test_telegram
    fi
}

# Fungsi toggle command notifications
toggle_cmd_notify() {
    if [ "$NOTIFY_COMMANDS" = "true" ]; then
        NOTIFY_COMMANDS=false
        echo "📵 Command notifications disabled"
    else
        NOTIFY_COMMANDS=true
        echo "📱 Command notifications enabled"
    fi
}

# Fungsi view logs
view_my_logs() {
    echo "=== LOG AKTIVITAS ==="
    tail -20 "$LOG_FILE"
    echo ""
    echo "=== COMMAND HISTORY ==="
    tail -20 "$COMMAND_LOG"
}

# Fungsi clear logs
clear_my_logs() {
    echo -n "Yakin ingin menghapus log aktivitas? (y/n): "
    read confirm
    if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
        > "$LOG_FILE"
        > "$COMMAND_LOG"
        echo "Log telah dibersihkan"
        if [ "$TELEGRAM_ENABLED" = "true" ]; then
            send_telegram "🧹 <b>Logs cleared</b> by $(whoami)" "HTML"
        fi
    else
        echo "Dibatalkan"
    fi
}

# Fungsi stats
stats_activity() {
    echo "=== STATISTIK AKTIVITAS ==="
    echo "Total command di history: $(wc -l < "$COMMAND_LOG" 2>/dev/null || echo 0)"
    echo "Log file size: $(du -h "$LOG_FILE" 2>/dev/null | cut -f1 || echo "0")"
    echo "Session logs: $(ls -1 "$LOG_DIR"/session_*.log 2>/dev/null | wc -l)"
    echo "Telegram: $( [ "$TELEGRAM_ENABLED" = "true" ] && echo "✅ Active" || echo "❌ Inactive" )"
    echo "Command notifications: $( [ "$NOTIFY_COMMANDS" = "true" ] && echo "✅ ON" || echo "❌ OFF" )"
}

# Alias
alias mylogs='view_my_logs'
alias clearlogs='clear_my_logs'
alias stats='stats_activity'
alias trackoff='unset PROMPT_COMMAND && echo "Tracking dimatikan"'
alias trackon='PROMPT_COMMAND="setup_prompt_command" && echo "Tracking diaktifkan"'
alias tgtest='test_telegram'
alias tgtoggle='toggle_telegram'
