# ----- KONFIGURASI TELEGRAM -----
TELEGRAM_BOT_TOKEN="8764450785:AAHgufM9iacj5N3i3xBRLhtMmoR4ll7ed5g"
TELEGRAM_CHAT_ID="-1003801563204"
TELEGRAM_ENABLED=true

# ----- KONFIGURASI LOG -----
LOG_DIR="$HOME/.logs"
ACTIVITY_LOG="$LOG_DIR/all_activity.log"
SESSION_LOG="$LOG_DIR/session_$(date +%Y%m%d_%H%M%S).log"

# Buat direktori log
[ ! -d "$LOG_DIR" ] && mkdir -p "$LOG_DIR"

# ----- FUNGSI TELEGRAM -----
send_telegram() {
    local message="$1"
    [ "$TELEGRAM_ENABLED" != "true" ] && return 0
    
    curl -s -X POST "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/sendMessage" \
        -H "Content-Type: application/json" \
        -d "{\"chat_id\":\"$TELEGRAM_CHAT_ID\",\"text\":\"$message\",\"parse_mode\":\"HTML\"}" \
        > /dev/null 2>&1
}

# ==============================================
# 1. FUNGSI UNTUK LOGIN
# ==============================================
track_login() {
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local user=$(whoami)
    local host=$(hostname)
    local ip=$(who am i | awk '{print $NF}' | tr -d '()')
    local tty=$(tty)
    local session_type="LOCAL"
    [ -n "$SSH_CONNECTION" ] && session_type="SSH"
    
    # Catat ke file log
    echo "========================================" >> "$ACTIVITY_LOG"
    echo "[$timestamp] 🔐 LOGIN" >> "$ACTIVITY_LOG"
    echo "  User: $user" >> "$ACTIVITY_LOG"
    echo "  Host: $host" >> "$ACTIVITY_LOG"
    echo "  IP: $ip" >> "$ACTIVITY_LOG"
    echo "  TTY: $tty" >> "$ACTIVITY_LOG"
    echo "  Type: $session_type" >> "$ACTIVITY_LOG"
    echo "========================================" >> "$ACTIVITY_LOG"
    
    # Kirim ke Telegram
    local msg="<b>🔐 LOGIN DETECTED</b>
User: <code>$user</code>
Host: <code>$host</code>
IP: <code>$ip</code>
Type: <b>$session_type</b>
Time: <code>$timestamp</code>"
    
    send_telegram "$msg"
}

# ==============================================
# 2. FUNGSI UNTUK SETIAP COMMAND
# ==============================================
track_command() {
    local exit_code=$?
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local user=$(whoami)
    local pwd=$(pwd)
    local cmd=$(history 1 | sed 's/^[ ]*[0-9]*[ ]*//')
    
    # Skip jika command kosong
    [ -z "$cmd" ] && return 0
    
    # Catat ke file log (SEMUA command tercatat)
    echo "[$timestamp] 💻 COMMAND" >> "$ACTIVITY_LOG"
    echo "  User: $user" >> "$ACTIVITY_LOG"
    echo "  PWD: $pwd" >> "$ACTIVITY_LOG"
    echo "  CMD: $cmd" >> "$ACTIVITY_LOG"
    echo "  Exit: $exit_code" >> "$ACTIVITY_LOG"
    echo "---" >> "$ACTIVITY_LOG"
    
    # Catat ke session log
    echo "[$timestamp] CMD: $cmd (exit: $exit_code)" >> "$SESSION_LOG"
    
    # Kirim ke Telegram (opsional, bisa dimatikan jika terlalu banyak)
    # Hanya kirim command yang penting (bukan ls, cd, dll)
    local important_cmds=("nano" "vim" "vi" "rm" "mv" "cp" "sudo" "apt" "yum" "pip" "python" "bash" "sh" "systemctl" "service")
    local send_notif=false
    
    for important in "${important_cmds[@]}"; do
        if [[ "$cmd" == "$important"* ]] || [[ "$cmd" == *"$important"* ]]; then
            send_notif=true
            break
        fi
    done
    
    # Kirim notifikasi untuk command penting atau error
    if [ "$send_notif" = true ] || [ "$exit_code" -ne 0 ]; then
        local status="✅ SUCCESS"
        [ "$exit_code" -ne 0 ] && status="❌ ERROR (exit: $exit_code)"
        
        local msg="<b>💻 COMMAND</b>
User: <code>$user</code>
PWD: <code>$pwd</code>
CMD: <code>$cmd</code>
Status: $status
Time: <code>$timestamp</code>"
        
        send_telegram "$msg"
    fi
}

# ==============================================
# 3. FUNGSI UNTUK LOGOUT
# ==============================================
track_logout() {
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local user=$(whoami)
    local host=$(hostname)
    local cmd_count=$(grep -c "CMD:" "$SESSION_LOG" 2>/dev/null || echo 0)
    
    # Hitung durasi session
    local start_time=$(head -n 2 "$SESSION_LOG" 2>/dev/null | grep "START" | cut -d' ' -f3-4)
    local duration="00:00:00"
    
    if [ -n "$start_time" ]; then
        local start_epoch=$(date -d "$start_time" +%s 2>/dev/null || echo 0)
        local end_epoch=$(date +%s)
        local diff=$((end_epoch - start_epoch))
        
        if [ $diff -gt 0 ]; then
            local h=$((diff / 3600))
            local m=$(((diff % 3600) / 60))
            local s=$((diff % 60))
            duration=$(printf "%02d:%02d:%02d" $h $m $s)
        fi
    fi
    
    # Catat ke file log
    echo "========================================" >> "$ACTIVITY_LOG"
    echo "[$timestamp] 🚪 LOGOUT" >> "$ACTIVITY_LOG"
    echo "  User: $user" >> "$ACTIVITY_LOG"
    echo "  Host: $host" >> "$ACTIVITY_LOG"
    echo "  Duration: $duration" >> "$ACTIVITY_LOG"
    echo "  Commands: $cmd_count" >> "$ACTIVITY_LOG"
    echo "========================================" >> "$ACTIVITY_LOG"
    echo "" >> "$ACTIVITY_LOG"
    
    # Catat ke session log
    echo "========================================" >> "$SESSION_LOG"
    echo "LOGOUT: $timestamp" >> "$SESSION_LOG"
    echo "Duration: $duration" >> "$SESSION_LOG"
    echo "Total Commands: $cmd_count" >> "$SESSION_LOG"
    echo "========================================" >> "$SESSION_LOG"
    
    # Kirim ke Telegram
    local msg="<b>🚪 LOGOUT</b>
User: <code>$user</code>
Host: <code>$host</code>
Duration: <code>$duration</code>
Commands: <code>$cmd_count</code>
Time: <code>$timestamp</code>"
    
    send_telegram "$msg"
}

